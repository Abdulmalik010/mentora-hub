# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-before-any-shared-deploy
SQLALCHEMY_DATABASE_URI=sqlite:///mentora.db

# Meta Model API (https://dev.meta.ai/docs). No defaults for model IDs.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_AGENT=
META_MODEL_FAST=
META_MODEL_TRANSCRIBE=

# Email provider placeholders (Resend vs SMTP decision pending).
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Mentora

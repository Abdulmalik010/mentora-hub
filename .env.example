# Copy to .env and fill in. Never commit .env.
SECRET_KEY=
SQLALCHEMY_DATABASE_URI=sqlite:///mentora.db
SESSION_COOKIE_SECURE=0
SEED_DEMO_PASSWORD=

# Meta Model API (https://dev.meta.ai/docs). No defaults for model IDs.
# META_API_KEY preferred; MODEL_API_KEY (the name Meta docs use) also accepted.
META_API_KEY=
# MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_AGENT=
META_MODEL_FAST=
META_MODEL_TRANSCRIBE=
# Reasoning effort (minimal/low/medium/high/xhigh/max). Agent unset = server
# default; fast defaults to low. Never 'none' (Muse models reject it).
META_EFFORT_AGENT=
META_EFFORT_FAST=low
# Session audio: deleted right after transcription unless true (debug only;
# never enable with real student audio on a shared host).
KEEP_AUDIO=false
# Diagnosis architecture: parallel (3 concurrent specialists + merge) or
# single (one call). Parallel is the default; single kept for A/B comparison.
DIAGNOSIS_MODE=parallel
# Matching architecture: fast (code retrieval + one ranking call, default) or
# agentic (tool loop, 3 turns max). Fast meets the <=20s matching target.
MATCH_MODE=fast
# Fast-mode ranking model: spark (META_MODEL_FAST, default) or wonder
# (META_MODEL_AGENT). Compare with: eval_matching --rank-model wonder.
MATCH_RANK_MODEL=spark

# Email: resend (HTTPS) or outbox (local .eml files, default, never delivers).
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Demo safety: redirect every email here with a "Demo: intended for" banner.
# Required for real delivery: the Resend sandbox only delivers to you, and
# @example.com sample addresses are never sent to directly.
DEMO_RECIPIENT_OVERRIDE=
EMAIL_OUTBOX_DIR=outbox
